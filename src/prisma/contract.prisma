// use prisma-8
enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Tenant {
  id        String       @id @onCreate(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @onUpdate(now())

  users     User[]

  @@map("tenants")
}

model User {
  id        String   @id @onCreate(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @onUpdate(now())

  @@map("users")
}
